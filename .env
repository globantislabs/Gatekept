# ─── Database Configuration ──────────────────────────────────────
# 
# Production (Plesk MariaDB):
#   1. Run: bun run db:use-mysql   (switches Prisma schema to MySQL/MariaDB)
#   2. Set DATABASE_URL to MariaDB connection string
#   3. Run: npx prisma db push     (creates tables on MariaDB)
#   4. Run: bun run seed           (seeds initial data)
#
# Local Dev (SQLite - use when no MariaDB available):
#   1. Run: bun run db:use-sqlite  (switches Prisma schema to SQLite)
#   2. DATABASE_URL points to local SQLite file (below)
#   3. Run: bun run db:push        (creates tables in SQLite)
#   4. Run: bun run seed           (seeds initial data)
#
# ─── MariaDB (Plesk Production) ─────────────────────────────────
# DATABASE_URL=mysql://notjustwatrdb:YOUR_PASSWORD@localhost:3306/notjustwatr_com
#
# ─── SQLite (Local Dev - sandbox) ────────────────────────────────
DATABASE_URL=file:/home/z/my-project/db/custom.db

# ─── SMS OTP Service ────────────────────────────────────────────
SMSALERT_USER=
SMSALERT_PWD=
SMSALERT_SENDER=NJWATR

# ─── Auth ────────────────────────────────────────────────────────
NEXTAUTH_SECRET=dev-secret-change-in-production
NEXTAUTH_URL=http://localhost:3000
