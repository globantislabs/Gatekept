# ──────────────────────────────────────────────────────────────────
# NOTJUST Watr — Production Environment Template (Plesk + MariaDB)
# ──────────────────────────────────────────────────────────────────
# Copy this file to .env.production and fill in your values
# Or set these values in Plesk > Node.js > Environment Variables
#
# IMPORTANT: Special characters in passwords must be URL-encoded
# in DATABASE_URL. Example: @ → %40, # → %23, / → %2F
# ──────────────────────────────────────────────────────────────────

# ─── Core ────────────────────────────────────────────────────────
NODE_ENV=production
# PORT is set automatically by Plesk — do not set here
# HOSTNAME is set by server.js to 0.0.0.0 — do not set here

# ─── Database (MariaDB on Plesk) ─────────────────────────────────
DATABASE_URL=mysql://DB_USER:DB_PASSWORD@localhost:3306/notjustwatr_com

# ─── WhatsApp Business API (Primary OTP method) ──────────────────
WHATSAPP_TOKEN=YOUR_WHATSAPP_BUSINESS_API_TOKEN
WHATSAPP_PHONE_NUMBER_ID=YOUR_WHATSAPP_PHONE_NUMBER_ID

# ─── Zoho Email (SMTP for transactional emails) ──────────────────
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_EMAIL=YOUR_ZOHO_EMAIL_ADDRESS
ZOHO_PASSWORD=YOUR_ZOHO_APP_PASSWORD

# ─── SMS OTP (SMSAlert.co.in) — ON HOLD / INACTIVE ──────────────
# WhatsApp OTP is the primary OTP delivery method.
# SMSAlert is held inactive. To activate later:
#   1. Set SMSALERT_ACTIVE=true
#   2. Fill SMSALERT_USER and SMSALERT_PWD with your SMSAlert credentials
SMSALERT_ACTIVE=false
SMSALERT_USER=
SMSALERT_PWD=
SMSALERT_SENDER=NJWATR

# ─── Auth (NextAuth.js v4) ────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 32
NEXTAUTH_SECRET=GENERATE_WITH_openssl_rand_base64_32
# Set to your actual domain with HTTPS
NEXTAUTH_URL=https://yourdomain.com
