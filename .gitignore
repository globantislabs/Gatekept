# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — ignore dev secrets, but allow production & example/template files
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
!.env.production
!.env.production.example
!.env.production.template

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt
server.log
logs/

# ─── NEVER track these (dev artifacts / secrets / bulk data) ────
# Screenshots & verification PNGs at project root
/*.png
/*.jpg
/*.jpeg
/*.webp

# Uploads directory (pasted images, PDFs)
/upload/

# Tool results (agent debug output)
/tool-results/

# Agent context files (dev session logs)
/agent-ctx/

# Skills directory (AI skill modules — too large for git)
/skills/

# Database files (SQLite local dev — never in git)
/db/

# Download directory
/download/

# Examples directory (websocket demo — not part of app)
/examples/

# Z-scripts (dev environment scripts)
/.zscripts/

# Worklog (dev session tracking)
/worklog.md

# Uploaded files (keep directories, ignore content)
public/uploads/products/*
public/uploads/videos/*
public/uploads/audio/*
public/uploads/images/*
!public/uploads/**/.gitkeep

# Uploaded files (persistent)
data/uploads/
