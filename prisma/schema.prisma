// NOTJUST Watr - Production Database Schema
// Prisma + SQLite for local dev, ready for Supabase migration

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Users & Auth ───────────────────────────────────────────

model UserProfile {
  id              String   @id @default(cuid())
  user_id         String   @unique
  name            String
  age             Int?
  gender          String?
  phone           String?
  email           String?  @unique
  country         String   @default("India")
  state           String?
  avatar_url      String?
  learning_completed Boolean @default(false)
  is_admin        Boolean  @default(false)
  password_hash   String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  // Relations
  learningProgress    ProductLearningProgress[]
  qrScans             QrScan[]
}

// ─── Products ───────────────────────────────────────────────

model Product {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String?
  short_description String?
  price           Float
  mrp             Float?
  stock           Int      @default(0)
  image_url       String?
  gallery_images  String?
  type            String   @default("FIZZ")
  category        String?  @default("Wellness Shot")
  sku             String?
  weight          String?
  ingredients     String?
  nutrition_info  String?
  tags            String?
  active          Boolean  @default(true)
  featured        Boolean  @default(false)
  brand           String?  @default("NOTJUST")
  flavor          String?
  serving_size    String?
  allergen_info   String?
  storage_info    String?
  shelf_life      String?
  country_origin  String?  @default("India")
  fssai_license   String?
  hsn_code        String?
  gst_rate        Float?   @default(18)
  min_order_qty   Int?     @default(1)
  max_order_qty   Int?     @default(10)
  discount_label  String?
  highlights      String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  // Relations
  videos          ProductVideo[]
  quizzes         ProductQuiz[]
  learningProgress ProductLearningProgress[]
}

// ─── Product Videos (Learning Content) ──────────────────────

model ProductVideo {
  id              String   @id @default(cuid())
  product_id      String
  title           String
  duration        String   @default("5:00")
  description     String?
  order           Int      @default(0)
  video_url       String?
  thumbnail_url   String?
  active          Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  product         Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  quizzes         ProductQuiz[]
}

// ─── Product Quiz Questions ─────────────────────────────────

model ProductQuiz {
  id              String   @id @default(cuid())
  product_id      String
  video_id        String
  question        String
  options         String   // JSON array of strings
  answer          Int
  category        String?  @default("general")
  difficulty      String   @default("EASY")
  order           Int      @default(0)
  active          Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  product         Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  video           ProductVideo @relation(fields: [video_id], references: [id], onDelete: Cascade)
}

// ─── Learning Progress ──────────────────────────────────────

model ProductLearningProgress {
  id              String   @id @default(cuid())
  user_id         String
  product_id      String
  video_progress  String   @default("{}")
  quiz_answers    String   @default("{}")
  quiz_completed  Boolean  @default(false)
  quiz_score      Int      @default(0)
  status          String   @default("NOT_STARTED")
  completed_at    DateTime?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  user            UserProfile @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product         Product    @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([user_id, product_id])
}

// ─── Marketing Campaigns ────────────────────────────────────

model Campaign {
  id              String   @id @default(cuid())
  name            String
  channel         String   @default("HOTEL")
  partner_name    String?
  location        String?
  start_date      DateTime?
  end_date        DateTime?
  status          String   @default("ACTIVE")
  qr_code_url     String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  // Relations
  qrScans         QrScan[]
}

// ─── QR Scan Tracking ──────────────────────────────────────

model QrScan {
  id              String   @id @default(cuid())
  campaign_id     String?
  user_id         String?
  device          String?
  location        String?
  created_at      DateTime @default(now())

  campaign        Campaign? @relation(fields: [campaign_id], references: [id])
  user            UserProfile? @relation(fields: [user_id], references: [id])
}
