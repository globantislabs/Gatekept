// NOTJUST Watr - SQLite Database Schema (for local dev)
// Use this when developing locally where MariaDB is not available.
// Switch to this schema with: bun run db:use-sqlite

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Users & Auth ───────────────────────────────────────────

model UserProfile {
  id              String   @id @default(cuid())
  user_id         String   @unique
  name            String
  age             Int?
  gender          String?
  phone           String?
  email           String?  @unique
  country         String   @default("India")
  state           String?
  avatar_url      String?
  learning_completed Boolean @default(false)
  is_admin        Boolean  @default(false)
  password_hash   String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  // Relations
  learningProgress    ProductLearningProgress[]
  qrScans             QrScan[]
  orders              Order[]
  subscriptions       Subscription[]
  otpVerifications    OtpVerification[]
  notificationLogs    NotificationLog[]
}

// ─── Products ───────────────────────────────────────────────

model Product {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String?
  short_description String?
  price           Float
  mrp             Float?
  stock           Int      @default(0)
  image_url       String?
  gallery_images  String?
  type            String   @default("FIZZ")
  category        String?  @default("Wellness Shot")
  sku             String?
  weight          String?
  ingredients     String?
  nutrition_info  String?
  tags            String?
  active          Boolean  @default(true)
  featured        Boolean  @default(false)
  brand           String?  @default("NOTJUST")
  flavor          String?
  serving_size    String?
  allergen_info   String?
  storage_info    String?
  shelf_life      String?
  country_origin  String?  @default("India")
  fssai_license   String?
  hsn_code        String?
  gst_rate        Float?   @default(18)
  min_order_qty   Int?     @default(1)
  max_order_qty   Int?     @default(10)
  discount_label  String?
  highlights      String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  // Relations
  videos          ProductVideo[]
  quizzes         ProductQuiz[]
  learningProgress ProductLearningProgress[]
  orderItems      OrderItem[]
  subscriptions   Subscription[]
}

// ─── Product Videos (Learning Content) ──────────────────────

model ProductVideo {
  id              String   @id @default(cuid())
  product_id      String
  title           String
  duration        String   @default("5:00")
  description     String?
  order           Int      @default(0)
  video_url       String?
  thumbnail_url   String?
  active          Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  product         Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  quizzes         ProductQuiz[]
}

// ─── Product Quiz Questions ─────────────────────────────────

model ProductQuiz {
  id              String   @id @default(cuid())
  product_id      String
  video_id        String
  question        String
  options         String   // JSON array of strings
  answer          Int
  category        String?  @default("general")
  difficulty      String   @default("EASY")
  order           Int      @default(0)
  active          Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  product         Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  video           ProductVideo @relation(fields: [video_id], references: [id], onDelete: Cascade)
}

// ─── Learning Progress ──────────────────────────────────────

model ProductLearningProgress {
  id              String   @id @default(cuid())
  user_id         String
  product_id      String
  video_progress  String   @default("{}")
  quiz_answers    String   @default("{}")
  quiz_completed  Boolean  @default(false)
  quiz_score      Int      @default(0)
  status          String   @default("NOT_STARTED")
  completed_at    DateTime?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  user            UserProfile @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product         Product    @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([user_id, product_id])
}

// ─── Marketing Campaigns ────────────────────────────────────

model Campaign {
  id              String   @id @default(cuid())
  name            String
  channel         String   @default("HOTEL")
  partner_name    String?
  location        String?
  start_date      DateTime?
  end_date        DateTime?
  status          String   @default("ACTIVE")
  qr_code_url     String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  // Relations
  qrScans         QrScan[]
}

// ─── QR Scan Tracking ──────────────────────────────────────

model QrScan {
  id              String   @id @default(cuid())
  campaign_id     String?
  user_id         String?
  device          String?
  location        String?
  created_at      DateTime @default(now())

  campaign        Campaign? @relation(fields: [campaign_id], references: [id])
  user            UserProfile? @relation(fields: [user_id], references: [id])
}

// ─── Orders ────────────────────────────────────────────────────

model Order {
  id              String   @id @default(cuid())
  user_id         String
  order_number    String   @unique
  status          String   @default("PLACED")  // PLACED, CONFIRMED, PROCESSING, SHIPPED, DELIVERED, CANCELLED
  total_amount    Float
  subtotal        Float
  tax_amount      Float    @default(0)
  discount_amount Float    @default(0)
  currency        String   @default("INR")
  shipping_name   String?
  shipping_phone  String?
  shipping_address String?
  shipping_city   String?
  shipping_state  String?
  shipping_pincode String?
  payment_method  String?  @default("UPI")
  payment_status  String   @default("PENDING") // PENDING, COMPLETED, FAILED, REFUNDED
  payment_ref     String?
  notes           String?
  delivered_at    DateTime?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  // Relations
  user            UserProfile @relation(fields: [user_id], references: [id], onDelete: Cascade)
  items           OrderItem[]
  tracking        OrderTracking[]
  subscription    Subscription?
}

model OrderItem {
  id              String   @id @default(cuid())
  order_id        String
  product_id      String
  product_name    String
  product_type    String   @default("FIZZ")
  quantity        Int      @default(1)
  unit_price      Float
  total_price     Float
  pack_type       String?  // 30_DAY, 60_DAY, 90_DAY, 180_DAY
  pack_days       Int?
  pack_discount   Float?   @default(0)
  created_at      DateTime @default(now())

  order           Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [product_id], references: [id])
}

// ─── Order Tracking ────────────────────────────────────────────

model OrderTracking {
  id              String   @id @default(cuid())
  order_id        String
  status          String   // PLACED, CONFIRMED, PROCESSING, SHIPPED, OUT_FOR_DELIVERY, DELIVERED, CANCELLED
  location        String?
  description     String?
  tracked_at      DateTime @default(now())

  order           Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
}

// ─── Subscriptions ──────────────────────────────────────────────

model Subscription {
  id              String   @id @default(cuid())
  user_id         String
  order_id        String   @unique
  product_id      String
  product_name    String
  product_type    String   @default("FIZZ")
  pack_type       String   // 30_DAY, 60_DAY, 90_DAY, 180_DAY
  pack_days       Int
  pack_discount   Float    @default(0)
  quantity        Int      @default(1)
  unit_price      Float
  frequency_days  Int      @default(30)  // delivery every N days
  status          String   @default("ACTIVE") // ACTIVE, PAUSED, CANCELLED, EXPIRED
  next_delivery   DateTime?
  start_date      DateTime @default(now())
  end_date        DateTime?
  paused_at       DateTime?
  cancelled_at    DateTime?
  total_cycles    Int      @default(0)
  completed_cycles Int     @default(0)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  user            UserProfile @relation(fields: [user_id], references: [id], onDelete: Cascade)
  order           Order      @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product         Product    @relation(fields: [product_id], references: [id])
}

// ─── OTP Verification ──────────────────────────────────────────

model OtpVerification {
  id            String   @id @default(cuid())
  phone         String
  otp_code      String                    // SHA-256 hashed OTP (never plaintext)
  purpose       String                    // CANCEL_ORDER, CANCEL_SUB, PAUSE_SUB, RESUME_SUB, MODIFY_ADDRESS, VERIFY_PHONE
  reference_id  String?                   // order_id or subscription_id
  user_id       String?                   // Link to user profile
  status        String   @default("PENDING")  // PENDING, VERIFIED, EXPIRED, FAILED
  attempts      Int      @default(0)
  max_attempts  Int      @default(3)
  sms_sent      Boolean  @default(false)
  sms_reference String?                   // SMSAlert delivery reference
  expires_at    DateTime
  verified_at   DateTime?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  user          UserProfile? @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([phone, purpose, status])
  @@index([reference_id])
}

// ─── Notification Log ──────────────────────────────────────────

model NotificationLog {
  id              String   @id @default(cuid())
  user_id         String?
  order_id        String?
  channel         String   // EMAIL, WHATSAPP, SMS
  type            String   // ORDER_PLACED, ORDER_CONFIRMED, PAYMENT_RECEIVED, etc.
  recipient       String   // email address or phone number
  subject         String?
  content         String?
  status          String   @default("PENDING") // PENDING, SENT, FAILED, DELIVERED
  error_message   String?
  provider_ref    String?  // delivery reference from provider
  sent_at         DateTime?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  user            UserProfile? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([user_id, type])
  @@index([channel, status])
}
